# Agent-notify runtime overrides. All variables are optional.
# 2.0 桌面版（agentnotify-desktop + agentnotify-ingress + Hook / 插件 / mod）读取第一段；
# Go 1.x 单文件运行时（回滚窗口保留）读取最后一段，变量互不通用。

# ------------------------------------------------------------------
# 2.0 桌面版运行时位置（默认 %LOCALAPPDATA%\AgentNotify\...）
# ------------------------------------------------------------------
#AGENT_NOTIFY_CONFIG_DIR=%LOCALAPPDATA%\AgentNotify\data
#AGENT_NOTIFY_DATA_DIR=%LOCALAPPDATA%\AgentNotify\data
#AGENT_NOTIFY_LOG_DIR=%LOCALAPPDATA%\AgentNotify\logs
#AGENT_NOTIFY_SPOOL_DIR=%LOCALAPPDATA%\AgentNotify\spool
#AGENT_NOTIFY_TEMP_DIR=%TEMP%\agent-notify

# ------------------------------------------------------------------
# 2.0 接入：Codex / Antigravity / Devin Hook exe
# ------------------------------------------------------------------
# Hook 定位 agentnotify-ingress.exe；未设置时用同目录或正式安装目录。
#AGENT_NOTIFY_INGRESS=%LOCALAPPDATA%\Programs\Agent-notify\agentnotify-ingress.exe
# 仅 Codex Hook：显式指定上游 codex-computer-use.exe（缺失即报错，不做猜测回退）。
#AGENT_NOTIFY_CODEX_UPSTREAM=%USERPROFILE%\bin\codex-computer-use.exe

# ------------------------------------------------------------------
# 2.0 接入：OpenCode 插件与 Command Code mod
# ------------------------------------------------------------------
# 覆盖 agentnotify-ingress.exe 路径，优先级高于安装器写入的 BAKED_INGRESS。
#AGENT_NOTIFY_INGRESS_BIN=%LOCALAPPDATA%\Programs\Agent-notify\agentnotify-ingress.exe
# OpenCode 插件：引用回复提交超时毫秒数。
#AGENT_NOTIFY_OPENCODE_REPLY_TIMEOUT_MS=30000
# Command Code：开关 marker、回复收件箱、回复窗口秒数（0 = 不等待，最大 600）。
#AGENT_NOTIFY_COMMANDCODE_MARKER_FILE=%USERPROFILE%\.config\agent-notify\commandcode.off
#AGENT_NOTIFY_COMMANDCODE_REPLY_DIR=%USERPROFILE%\.config\agent-notify\commandcode-reply-inbox
#AGENT_NOTIFY_COMMANDCODE_WINDOW_SEC=60
# 总开关（1 = 不提交事件，Command Code mod 与 Go 1.x 插件都读取）与调试日志开关
# （OpenCode 插件写 opencode-debug.log，Command Code mod 写 commandcode-debug.log）。
#AGENT_NOTIFY_OFF=1
#AGENT_NOTIFY_DEBUG=1

# ------------------------------------------------------------------
# 2.0 更新器（Settings → 更新）
# ------------------------------------------------------------------
# 更新来源默认固定为镜像仓库 srafyhucl-cpu/agent-notify-releases，公开仓库无需 token。
#AGENT_NOTIFY_UPDATE_REPOSITORY=srafyhucl-cpu/agent-notify-releases
#AGENT_NOTIFY_UPDATE_API_BASE=https://api.github.com
#AGENT_NOTIFY_GITHUB_TOKEN=
# 追加信任的签名指纹（内置指纹始终生效）。
#AGENT_NOTIFY_SIGNATURE_THUMBPRINT=

# ------------------------------------------------------------------
# 构建与安装辅助
# ------------------------------------------------------------------
# go.exe 不在 PATH 时指定路径（Go 遗留门禁与 install.ps1 用）。
#AGENT_NOTIFY_GO=

# ------------------------------------------------------------------
# Go 1.x 单文件运行时（回滚窗口保留，2.0 不读取）
# ------------------------------------------------------------------
#AGENT_NOTIFY_BIN=%USERPROFILE%\bin\agent-notify.exe
#AGENT_NOTIFY_CONFIG_FILE=%USERPROFILE%\.config\agent-notify\config.json
#AGENT_NOTIFY_CREDENTIAL_FILE=%USERPROFILE%\.config\agent-notify\clawbot.json
#AGENT_NOTIFY_SETUP_STATE_FILE=%USERPROFILE%\.config\agent-notify\setup-state.json
#AGENT_NOTIFY_REPLY_ROUTE_FILE=%USERPROFILE%\.config\agent-notify\reply-routes.jsonl
#AGENT_NOTIFY_REPLY_STATE_FILE=%USERPROFILE%\.config\agent-notify\reply-state.jsonl
#AGENT_NOTIFY_PLUGIN_FILE=%USERPROFILE%\.config\opencode\plugins\agent-notify.ts
#AGENT_NOTIFY_SETUP_LOG_FILE=%TEMP%\agent-notify\setup.log
#AGENT_NOTIFY_LOG_FILE=%TEMP%\agent-notify\push.log
# 开关 marker（存在即停）：OpenCode / Antigravity / Devin / Command Code / Codex。
#AGENT_NOTIFY_OPENCODE_MARKER_FILE=%USERPROFILE%\.config\agent-notify\opencode.off
#AGENT_NOTIFY_ANTIGRAVITY_MARKER_FILE=%USERPROFILE%\.config\agent-notify\antigravity.off
#AGENT_NOTIFY_DEVIN_MARKER_FILE=%USERPROFILE%\.config\agent-notify\devin.off
#AGENT_NOTIFY_COMMANDCODE_MARKER_FILE=%USERPROFILE%\.config\agent-notify\commandcode.off
#AGENT_NOTIFY_CODEX_MARKER_FILE=%USERPROFILE%\.config\agent-notify\codex.off
# Go 版 OpenCode 插件：已发送状态、冷却、开关与调试。
#AGENT_NOTIFY_STATE_FILE=%TEMP%\agent-notify\opencode-sent.json
#AGENT_NOTIFY_COOLDOWN_MIN=10
#AGENT_NOTIFY_OPENCODE_FETCH_TIMEOUT_MS=10000
#AGENT_NOTIFY_REPLY_ENABLED=1
#AGENT_NOTIFY_REPLY_CONFIRMATION=1
#AGENT_NOTIFY_DRYRUN=1
#AGENT_NOTIFY_QUIET=23-8
#AGENT_NOTIFY_THEME=light
# Go 版 Codex / Antigravity / Devin 接入位置与调试。
#AGENT_NOTIFY_CODEX_CONFIG=%USERPROFILE%\.codex\config.toml
#AGENT_NOTIFY_CODEX_BIN=%USERPROFILE%\bin\codex.exe
#AGENT_NOTIFY_CODEX_DRYRUN=1
#AGENT_NOTIFY_CODEX_DEBUG=1
#AGENT_NOTIFY_ANTIGRAVITY_HOOKS=%USERPROFILE%\.gemini\config\hooks.json
#AGENT_NOTIFY_ANTIGRAVITY_LAUNCHER=%USERPROFILE%\.gemini\config\agent-notify-hook.cmd
#AGENT_NOTIFY_ANTIGRAVITY_ANNOTATIONS_DIR=%USERPROFILE%\.gemini\antigravity\annotations
#AGENT_NOTIFY_ANTIGRAVITY_BIN=%LOCALAPPDATA%\Programs\antigravity\resources\bin\language_server.exe
#AGENT_NOTIFY_ANTIGRAVITY_DRYRUN=1
#AGENT_NOTIFY_DEVIN_CONFIG=%APPDATA%\devin\config.json
#AGENT_NOTIFY_DEVIN_EXTENSION_DIR=%USERPROFILE%\.devin\extensions\agent-notify
#AGENT_NOTIFY_DEVIN_SESSIONS_DB=%APPDATA%\devin\cli\sessions.db
#AGENT_NOTIFY_DEVIN_DESKTOP_DB=%APPDATA%\devin\User\globalStorage\state.vscdb
#AGENT_NOTIFY_DEVIN_DRYRUN=1
#AGENT_NOTIFY_CLAWBOT_DEBUG=1
# Go 版更新器：=1 时拒绝未签名安装包（2.0 更新器固定要求签名）。
#AGENT_NOTIFY_REQUIRE_SIGNATURE=1
