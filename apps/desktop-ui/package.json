{
  "name": "agentnotify-desktop-ui",
  "private": true,
  "version": "2.0.7",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.8"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:a11y": "playwright test --config tests/playwright.config.ts --grep @a11y",
    "test:visual": "playwright test --config tests/playwright.config.ts --grep @visual",
    "bridge:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/rust/export-bindings.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-virtual": "3.14.13",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
