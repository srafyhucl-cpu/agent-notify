# Agent-notify editor conventions.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 needs UTF-8 BOM for non-ASCII installer scripts.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
